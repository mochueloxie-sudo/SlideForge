{
  "colorScheme": {
    "background": "#ffffff",
    "backgroundGradient": null,
    "textPrimary": "#1d1818",
    "textSecondary": "#aaaaaa",
    "primary": "#6366f1",
    "accent": "#6366f1",
    "accentLight": "#6366ff",
    "accentDark": "#000000"
  },
  "typography": {
    "title": {
      "font": "Heytea Sans Serif",
      "coverSize": 78,
      "sectionSize": 58,
      "weight": 700,
      "letterSpacing": "-0.03em",
      "lineHeight": 1.08
    },
    "body": {
      "font": "PingFang SC",
      "size": 22,
      "lineHeight": 1.55,
      "weight": 400
    },
    "code": {
      "font": "JetBrains Mono",
      "size": 18,
      "background": "rgba(99,102,241,0.10)",
      "border": "1px solid rgba(99,102,241,0.22)",
      "borderRadius": "10px"
    }
  },
  "decoration": {
    "glow": {
      "count": 1,
      "color": "#6366f1",
      "size": "600px",
      "blur": 150,
      "opacity": 0.15,
      "position": {
        "top": "-160px",
        "right": "-120px"
      }
    },
    "shapes": [
      "fixed-cover-content-closing",
      "brand-logo-lockup",
      "footer-bar"
    ],
    "panel": {
      "enabled": false
    },
    "hairline": {
      "enabled": false
    },
    "accentBar": {
      "enabled": false
    }
  },
  "specialElements": {
    "numbers": {
      "size": "56-72px",
      "color": "#6366ff",
      "weight": 700,
      "font": "Heytea Sans Serif"
    },
    "code": {
      "style": "glass-panel-inline"
    },
    "quotes": {
      "borderLeft": "none",
      "paddingLeft": "0",
      "font": "PingFang SC",
      "fontStyle": "normal",
      "fontWeight": 500,
      "fontSize": "28px",
      "color": "#1d1818"
    },
    "keyPoints": null
  },
  "layout_hint": "left_text_right_space",
  "design_mode": "heytea",
  "preset_name": "Heytea Office",
  "source": "frontend-presets-fallback",
  "page_directions": [
    {
      "id": "cover",
      "page_intent": "hero",
      "alignment": "center",
      "density": "low",
      "hero_element": "none",
      "content_variant": "text",
      "scene_content_variant": null,
      "resolved_content_variant": "text",
      "layout_hint": null,
      "decoration_policy": "subtle_glow",
      "negative_space": "large",
      "visual_priority": [
        "title",
        "subtitle"
      ],
      "avoid_elements": [
        "icons",
        "mixed-focus",
        "multi-box"
      ],
      "visual_weight": "normal",
      "composition": "default",
      "max_body_lines": 2,
      "max_key_points": 3
    },
    {
      "id": "agenda",
      "page_intent": "structure",
      "alignment": "left",
      "density": "medium",
      "hero_element": "key_points",
      "content_variant": "panel",
      "scene_content_variant": "panel",
      "resolved_content_variant": "panel",
      "layout_hint": "grid-3",
      "decoration_policy": "subtle_glow",
      "negative_space": "medium",
      "visual_priority": [
        "title",
        "structure"
      ],
      "avoid_elements": [
        "icons",
        "mixed-focus",
        "multi-box",
        "quote",
        "big-number",
        "code-block"
      ],
      "visual_weight": "hero",
      "composition": "default",
      "max_body_lines": 1,
      "max_key_points": 3
    },
    {
      "id": "metrics",
      "page_intent": "metric",
      "alignment": "left",
      "density": "medium",
      "hero_element": "stats",
      "content_variant": "stats_grid",
      "scene_content_variant": "stats_grid",
      "resolved_content_variant": "stats_grid",
      "layout_hint": "2x2",
      "decoration_policy": "none",
      "negative_space": "large",
      "visual_priority": [
        "numbers",
        "labels"
      ],
      "avoid_elements": [
        "icons",
        "mixed-focus",
        "multi-box",
        "quote",
        "code-block"
      ],
      "visual_weight": "normal",
      "composition": "stat-hero",
      "max_body_lines": 3,
      "max_key_points": 3,
      "layout_variation": "closing"
    },
    {
      "id": "closing",
      "page_intent": "summary",
      "alignment": "center",
      "density": "low",
      "hero_element": "none",
      "content_variant": "text",
      "scene_content_variant": null,
      "resolved_content_variant": "text",
      "layout_hint": null,
      "decoration_policy": "none",
      "negative_space": "medium",
      "visual_priority": [
        "title",
        "takeaway"
      ],
      "avoid_elements": [
        "icons",
        "mixed-focus",
        "multi-box"
      ],
      "visual_weight": "normal",
      "composition": "default",
      "max_body_lines": 2,
      "max_key_points": 3
    }
  ],
  "strategy_version": "director-v1",
  "page_animations": true,
  "page_animation_preset": "stagger",
  "enhancement": "minimal",
  "render_mode": "production",
  "typography_scale": "adapt"
}