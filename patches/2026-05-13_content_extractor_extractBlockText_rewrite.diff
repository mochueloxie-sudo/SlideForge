+function getElementsText(elements) {
+  if (!elements || !Array.isArray(elements) || !elements.length) return '';
+  return elements.map(e => {
+    if (e.text_run) return e.text_run.content || '';
+    if (e.docs_link) return e.docs_link.text || '';
